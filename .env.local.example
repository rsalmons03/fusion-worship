# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose). Used for serve-request emails, the public
# accept/decline page, and adding people.
SUPABASE_SERVICE_ROLE_KEY=

# Your church's name, shown in the header and emails
NEXT_PUBLIC_CHURCH_NAME=Fusion Church
# Public URL of the site, used in email links
NEXT_PUBLIC_SITE_URL=https://fusionchurchservices.cc

# Email via Resend (resend.com). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Fusion Church Worship <worship@fusionchurchservices.cc>
